<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>LANDO — GRIDO1 Racing Systems / Kimi Antonelli</title>
<meta name="description" content="Kimi Antonelli, driver_012 of GRIDO1 Racing Systems. Rookie season, Mercedes-AMG F1.">

<script type="importmap">
{
  "imports": {
    "three": "https://cdn.jsdelivr.net/npm/three@0.185.0/build/three.module.js",
    "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.185.0/examples/jsm/",
    "lenis": "https://cdn.jsdelivr.net/npm/lenis@1.3.26/dist/lenis.mjs"
  }
}
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;700&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">

<script>
  /* Before anything else: the page opens behind a veil and always starts at the top. */
  history.scrollRestoration = "manual";
  window.scrollTo(0, 0);
</script>

<style>
/* ============================================================================
   TOKENS — tier 1 (raw), tier 2 (roles). The only place a literal appears.
   There is no dark-mode override: the theme is fixed, each block picks a surface.
   ========================================================================= */
:root {
  --raw-color-ice-50: #f7fafb;
  --raw-color-ice-100: #ebeef1;
  --raw-color-ice-200: #dfe5e9;
  --raw-color-steel-400: #b6c1c8;
  --raw-color-ink-950: #090a0b;
  --raw-color-ink-900: #0e0f14;
  --raw-color-ink-800: #1b1d24;
  --raw-color-ink-700: #2a2d36;
  --raw-color-ink-alpha-35: rgb(9 10 11 / 0.35);
  --raw-color-slate-500: #7a7a7a;
  --raw-color-slate-600: #4d4d4d;
  --raw-color-slate-900: #1e1e1e;
  --raw-color-cyan-400: #02d2e3;
  --raw-color-cyan-alpha-25: rgb(2 210 227 / 0.25);
  --raw-color-stone-600: #535450;
  --raw-color-white-alpha-10: rgb(255 255 255 / 0.1);
  --raw-color-white-alpha-20: rgb(255 255 255 / 0.2);
  --raw-color-ink-alpha-08: rgb(9 10 11 / 0.08);
  --raw-color-white-alpha-40: rgb(255 255 255 / 0.4);
  --raw-color-white: #ffffff;
  --raw-color-orange-500: #ff6b00;

  --raw-font-size-96: 6rem;
  --raw-font-size-70: 4.375rem;
  --raw-font-size-52: 3.25rem;
  --raw-font-size-38: 2.375rem;
  --raw-font-size-20: 1.25rem;
  --raw-font-size-18: 1.125rem;
  --raw-font-size-16: 1rem;
  --raw-font-size-14: 0.875rem;
  --raw-font-size-12: 0.75rem;
  --raw-font-size-55: 3.4375rem;
  --raw-font-size-36: 2.25rem;

  --raw-leading-95: 0.95;
  --raw-leading-90: 0.9;
  --raw-leading-72: 0.72;
  --raw-leading-110: 1.1;
  --raw-tracking-stat: -0.08em;
  --raw-tracking-label: -0.04em;
  --raw-tracking-eyebrow: -0.02em;

  --raw-radius-16: 1rem; --raw-radius-48: 3rem; --raw-radius-100: 6.25rem;
  --raw-duration-fast: 150ms; --raw-duration-normal: 250ms; --raw-duration-slow: 700ms;
  --raw-edge-fade-share: 10%; --raw-edge-fade-length: 6rem;

  /* tier 2 — roles */
  --background: var(--raw-color-ice-50);
  --foreground: var(--raw-color-ink-950);
  --foreground-muted: var(--raw-color-ink-alpha-35);
  --surface-dark: var(--raw-color-ink-900);
  --surface-dark-raised: var(--raw-color-ink-800);
  --surface-black: var(--raw-color-ink-950);
  --surface-muted: var(--raw-color-ice-100);
  --surface-soft: var(--raw-color-ice-200);
  --foreground-on-dark: var(--raw-color-white);
  --foreground-on-dark-muted: var(--raw-color-steel-400);
  --foreground-on-dark-faint: var(--raw-color-white-alpha-40);
  --border-muted: var(--raw-color-ice-200);
  --border-on-dark: var(--raw-color-ink-700);
  --map-dot: var(--raw-color-slate-500);
  --map-grid: var(--raw-color-slate-600);
  --map-grid-ghost: var(--raw-color-slate-900);
  --map-mark: var(--raw-color-ice-50);
  --timeline-outline: var(--raw-color-stone-600);
  --timeline-fill: var(--raw-color-white-alpha-10);
  --timeline-rail: var(--raw-color-white-alpha-20);
  --paddock-contour: var(--raw-color-ink-alpha-08);
  --footer-contour: var(--raw-color-white-alpha-10);
  --accent: var(--raw-color-cyan-400);
  --accent-muted: var(--raw-color-cyan-alpha-25);

  --type-impact: var(--raw-font-size-96);
  --type-display-lg: var(--raw-font-size-70);
  --type-display: var(--raw-font-size-52);
  --type-heading: var(--raw-font-size-38);
  --type-title: var(--raw-font-size-20);
  --type-lead: var(--raw-font-size-18);
  --type-label: var(--raw-font-size-16);
  --type-body: var(--raw-font-size-14);
  --type-eyebrow: var(--raw-font-size-12);
  --type-display-sm: var(--raw-font-size-55);
  --type-year: var(--raw-font-size-36);

  --leading-headline: 0.95; --leading-flat: 0.9; --leading-cap: 0.72; --leading-display: 1.1;
  --duration-fast: 150ms; --duration-normal: 250ms; --duration-plate: 700ms;
  --ease-entrance: cubic-bezier(0.2, 0, 0, 1);
  --ease-plate: cubic-bezier(0.33, 0, 0, 1);
  --font-sans: "Space Grotesk", system-ui, sans-serif;
  --font-display: "Oswald", Impact, sans-serif;
}

/* ---- root font-size bands: a rem is one design pixel of the band's frame ---- */
html { font-size: 16px; }
@media (max-width: 1920px) { html { font-size: 0.833333vw; } }
@media (max-width: 1440px) { html { font-size: 1.111111vw; } }
@media (max-width: 1279px) { html { font-size: 16px; } }

/* the 1441-1920 band is based on 1920 but the hero + season were drawn at 1440 */
@media (min-width: 1441px) and (max-width: 1920px) {
  [data-hero] { --hero-base: calc(1920 / 1440);
    --type-impact: calc(6rem * var(--hero-base)); --type-display-lg: calc(4.375rem * var(--hero-base));
    --type-display: calc(3.25rem * var(--hero-base)); --type-heading: calc(2.375rem * var(--hero-base));
    --type-title: calc(1.25rem * var(--hero-base)); --type-lead: calc(1.125rem * var(--hero-base));
    --type-label: calc(1rem * var(--hero-base)); --type-body: calc(0.875rem * var(--hero-base));
    --type-eyebrow: calc(0.75rem * var(--hero-base)); }
  [data-hero] [data-hero-panels] { width: calc(13.625rem * var(--hero-base, 1)); }
  [data-hero] [data-hero-stats]  { width: calc(10.75rem * var(--hero-base, 1)); }
  [data-hero] [data-hero-map]    { height: calc(3.125rem * var(--hero-base, 1)); width: calc(4.875rem * var(--hero-base, 1)); }
  [data-season] { --season-base: calc(1920 / 1440);
    --type-display-sm: calc(3.4375rem * var(--season-base)); --type-lead: calc(1.125rem * var(--season-base));
    --type-body: calc(0.875rem * var(--season-base)); --type-eyebrow: calc(0.75rem * var(--season-base)); }
}

/* ============================================================================
   RESET
   ========================================================================= */
*, *::before, *::after { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  background: var(--background);
  color: var(--foreground);
  min-height: 100lvh;
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  overflow-x: hidden;
}
img, svg, canvas { display: block; max-width: 100%; }
a { color: inherit; text-decoration: none; }
ul, ol, dl, dd { margin: 0; padding: 0; list-style: none; }
h1, h2, h3, p, figure { margin: 0; }
button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
.sr-only {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
}
/* scroll lock while the mobile sheet is open */
html.is-locked { position: relative; overflow: hidden; height: 100%; }

/* text-engine primitives — no overflow clip anywhere: the display leadings
   (0.95, 0.72) would shave descenders. */
.tx { display: flex; flex-wrap: wrap; column-gap: 0.3em; }
.tx > span { display: inline-block; will-change: transform, opacity; }
.tx--letters { column-gap: 0em; }

/* ============================================================================
   THE STICKY STACK
   ========================================================================= */
[data-stack] { position: relative; background: var(--surface-black); }
[data-pin] { position: sticky; top: 0; }
[data-pin-inner] { transform-origin: center; }
[data-pin-shade] {
  position: absolute; inset: 0; background: var(--surface-black);
  opacity: 0; pointer-events: none; z-index: 40;
}
[data-pin-last] { position: relative; z-index: 20; }

/* ============================================================================
   1 — HERO
   ========================================================================= */
[data-hero] {
  position: relative; isolation: isolate;
  min-height: 100lvh; overflow: hidden;
  background: var(--background);
}
.hero__canvas {
  position: absolute; inset: 0; z-index: 0; pointer-events: none;
  width: 100%; height: 100%;
  transform: translateZ(0); backface-visibility: hidden; will-change: transform;
}
/* the layout-owned fit box the scene reads (below xl only) */
.hero__figure { position: absolute; inset: 0; margin: 0 -1.5rem; z-index: 1; pointer-events: none; }
.hero__fit { position: absolute; left: 0; right: 0; bottom: 0; height: 100%; }
@media (min-width: 768px) { .hero__fit { height: calc(100% - 2rem); } }
@media (min-width: 1024px) { .hero__fit { height: calc(100% - 4rem); } }
@media (max-width: 1023px) { .hero__figure { top: 30%; } }
@media (max-width: 639px)  { .hero__figure { top: 36%; } }
@media (min-width: 1280px) { .hero__figure { display: none; } }

/* the copy ramp (below xl only) — six stops tracing an ease */
.hero__ramp {
  position: absolute; left: 0; right: 0; bottom: 0; height: 22%; z-index: 10; pointer-events: none;
  background-image: linear-gradient(to bottom,
    color-mix(in srgb, var(--background) 0%, transparent) 0%,
    color-mix(in srgb, var(--background) 6%, transparent) 26%,
    color-mix(in srgb, var(--background) 20%, transparent) 46%,
    color-mix(in srgb, var(--background) 45%, transparent) 64%,
    color-mix(in srgb, var(--background) 74%, transparent) 80%,
    color-mix(in srgb, var(--background) 93%, transparent) 91%,
    var(--background) 100%);
}
.hero__ramp2 {
  position: absolute; left: 0; right: 0; bottom: -13rem; height: 26rem; z-index: 10; pointer-events: none;
  background: linear-gradient(to bottom, transparent, var(--background) 60%, var(--background));
}
@media (min-width: 768px)  { .hero__ramp2 { display: none; } }
@media (min-width: 1280px) { .hero__ramp { display: none; } }

.hero__content {
  position: relative; z-index: 20;
  min-height: 100lvh; display: flex; flex-direction: column;
  padding: 1.5rem; gap: 0.5rem;
}
@media (min-width: 640px)  { .hero__content { padding-left: 2rem; padding-right: 2rem; gap: 1rem; } }
@media (min-width: 768px)  { .hero__content { gap: 1.5rem; } }
@media (min-width: 1024px) { .hero__content { gap: 2rem; } }
@media (max-height: 500px) { .hero__content { padding-top: 0.75rem; padding-bottom: 0.75rem; gap: 1rem; } }

/* ---- masthead ---- */
.masthead {
  display: flex; align-items: center; justify-content: space-between;
  position: relative; z-index: 30;
}
.masthead__logo img, .sheet__logo img { height: 1.5rem; width: auto; }
.masthead__nav { position: absolute; left: 50%; transform: translateX(-50%); }
.masthead__nav ul { display: flex; gap: 4rem; }
.masthead__nav a, .masthead__garage {
  font-size: var(--type-label); text-transform: uppercase; line-height: var(--leading-flat);
  color: var(--foreground); transition: color var(--duration-fast) var(--ease-entrance);
}
.masthead__nav a:hover, .masthead__garage:hover { color: var(--accent); }
.masthead__garage { font-weight: 700; }
@media (max-width: 1279px) { .masthead__nav, .masthead__garage { display: none; } }
.burger { padding: 0.5rem; margin-right: -0.5rem; display: grid; gap: 0.3125rem; }
.burger span { display: block; width: 1.5rem; height: 1px; background: var(--foreground); }
@media (min-width: 1280px) { .burger { display: none; } }

/* ---- middle row ---- */
/* Below md the middle is transparent to the column, so the four blocks order
   themselves; the identity takes the free space so the copy sits on the foot,
   over the ramp, exactly as it does at xl. */
.hero__middle { display: contents; }
@media (max-width: 767px) {
  .masthead { order: 1; }
  .hero__identity { order: 2; margin-top: auto; }
  [data-hero-panels] { order: 3; }
  .hero__actions { order: 4; }
}
@media (min-width: 768px) {
  .hero__middle { display: flex; justify-content: space-between; gap: 2rem; margin-top: auto; }
}
@media (min-width: 1280px) {
  .hero__middle { flex: 1; display: flex; align-items: center; justify-content: space-between; margin-top: 0; }
}

/* ---- driver identity ---- */
.hero__identity { position: relative; order: 2; }
@media (min-width: 1280px) {
  .hero__identity {
    max-width: 26.0625rem; display: flex; flex-direction: column; gap: 6.0625rem;
  }
}
.hero__id {
  font-size: var(--type-label); text-transform: uppercase; line-height: var(--leading-flat);
  color: var(--foreground-muted); margin-bottom: 1rem;
}
@media (max-height: 500px) { .hero__id { margin-bottom: 0.25rem; } }
@media (min-width: 1280px) {
  .hero__id { position: absolute; left: 20.0625rem; top: 0.5625rem; margin-bottom: 0; }
}
.hero__name {
  font-family: var(--font-display); font-weight: 700;
  font-size: var(--type-display-lg); text-transform: uppercase;
  line-height: var(--leading-headline);
  max-width: 6em; justify-content: flex-start; text-align: left;
}
@media (max-height: 500px) { .hero__name { font-size: var(--type-heading); } }
@media (min-width: 768px)  { .hero__name { font-size: var(--type-impact); } }
@media (min-width: 1024px) { .hero__name { font-size: var(--type-display-lg); } }
@media (min-width: 1280px) { .hero__name { font-size: var(--type-impact); } }
.hero__meta { display: flex; flex-direction: column; gap: 1rem; margin-top: 1.5rem; }
@media (max-height: 500px) { .hero__meta { gap: 0.25rem; margin-top: 0.75rem; } }
@media (min-width: 1280px) { .hero__meta { margin-top: 0; } }
.hero__meta li { display: flex; align-items: center; gap: 0.5rem; }
.hero__meta span {
  font-size: var(--type-lead); text-transform: uppercase; line-height: var(--leading-flat);
}
.hero__meta img { flex: none; }
.ico-flag { width: 1.125rem; height: 0.75rem; }
.ico-rookie { width: 1rem; height: 1rem; }
.ico-merc { width: 0.875rem; height: 0.875rem; }

/* ---- bracket panels ---- */
[data-hero-panels] { order: 3; display: flex; flex-direction: column; gap: 2rem; }
@media (max-width: 639px) { [data-hero-panels] { display: none; } }
@media (min-width: 768px) { [data-hero-panels] { width: 13.625rem; } }
.panel { position: relative; padding: 1rem; color: var(--foreground); }
@media (min-width: 640px) { .panel { padding: 1rem 1.375rem 1.1875rem; } }
.panel__corner { position: absolute; width: 0.625rem; height: 0.625rem; overflow: visible; }
.panel__corner--tr { top: 0; right: 0; }
.panel__corner--tl { top: 0; left: 0; transform: scaleX(-1); }
.panel__corner--bl { bottom: 0; left: 0; transform: scale(-1); }
.panel__corner--br { bottom: 0; right: 0; transform: scaleY(-1); }
.panel__eyebrow {
  font-size: var(--type-eyebrow); font-weight: 500; text-transform: uppercase;
  line-height: var(--leading-flat); letter-spacing: var(--raw-tracking-eyebrow);
  color: var(--accent);
}
.panel__list {
  font-size: var(--type-body); text-transform: uppercase; line-height: var(--leading-flat);
  display: flex; flex-direction: column; gap: 0.375rem; margin-top: 1rem;
}
.panel__list dt { font-weight: 700; }
[data-hero-map] {
  width: 3.125rem; height: 4.875rem; object-fit: contain; object-position: left;
}
@media (min-width: 640px) { [data-hero-map] { width: 4.375rem; height: 6.25rem; object-position: right; } }
.panel__race { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
@media (min-width: 768px) {
  .panel__race { display: block; }
  .panel__race [data-hero-map] { margin-top: 1.75rem; margin-left: auto; }
}
[data-hero-stats] {
  margin-top: 1.5rem; display: flex; justify-content: space-between; width: 10.75rem;
}
@media (min-width: 768px) {
  [data-hero-stats] { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; width: auto; }
}
.stat { text-align: center; }
@media (min-width: 768px) { .stat { text-align: left; } }
.stat dt {
  font-size: var(--type-eyebrow); text-transform: uppercase;
  letter-spacing: var(--raw-tracking-label); white-space: nowrap;
}
.stat dd {
  font-family: var(--font-display); font-weight: 500;
  font-size: var(--type-heading); line-height: var(--leading-cap);
  letter-spacing: var(--raw-tracking-stat);
}
.stat dd .tx { justify-content: center; }
@media (min-width: 768px) { .stat dd .tx { justify-content: flex-start; } }

/* ---- actions row ---- */
.hero__actions { margin-top: 0.5rem; display: flex; flex-direction: column; gap: 1rem; }
@media (min-width: 640px) {
  .hero__actions {
    margin-top: 0; display: grid; grid-template-columns: 1fr auto 1fr;
    align-items: end; gap: 2rem;
  }
}
.trailer { display: flex; align-items: center; gap: 0.75rem; }
.trailer img { width: 2rem; height: 2rem; }
.trailer__lines {
  display: flex; flex-direction: column; gap: 0.375rem;
  font-size: var(--type-body); text-transform: uppercase; line-height: var(--leading-flat);
}
.trailer__lines b { font-weight: 500; transition: color var(--duration-fast) var(--ease-entrance); }
.trailer:hover .trailer__lines b { color: var(--accent); }
.trailer__lines time { color: var(--foreground-muted); }
.socials {
  display: flex; gap: 2rem; justify-content: flex-end;
  font-size: var(--type-body); text-transform: uppercase; line-height: var(--leading-flat);
}
@media (min-width: 1280px) { .socials { gap: 3.6875rem; } }
.socials a { transition: color var(--duration-fast) var(--ease-entrance); }
.socials a:hover { color: var(--accent); }
/* after the base rules, so the hide wins on a phone */
@media (max-width: 639px) { .trailer, .socials { display: none; } }

/* ---- profile CTA: a 220x50 frame measured in em off its own 20px label ---- */
.cta {
  position: relative; font-size: var(--type-title);
  display: flex; align-items: center; justify-content: center; gap: 1.6em;
  width: 100%; height: 3.5rem;
}
@media (min-width: 640px) { .cta { height: 2.5em; width: 11em; } }
.cta__frame { position: absolute; inset: 0; width: 100%; height: 100%; }
.cta__flood { transform-origin: left; transform: scaleX(0); transition: transform var(--duration-normal) var(--ease-plate); }
.cta:hover .cta__flood { transform: scaleX(1); }
.cta__label {
  position: relative; text-transform: uppercase; line-height: var(--leading-flat);
  color: var(--accent); transition: color var(--duration-normal) var(--ease-plate);
}
.cta:hover .cta__label { color: var(--surface-black); }
.cta__arrow {
  position: relative; width: 0.65em; height: 0.5em; overflow: visible;
  transition: transform var(--duration-fast) var(--ease-entrance);
}
.cta__arrow path { stroke: var(--accent); transition: stroke var(--duration-normal) var(--ease-plate); }
.cta:hover .cta__arrow { transform: translateX(0.25rem); }
.cta:hover .cta__arrow path { stroke: var(--surface-black); }

/* ============================================================================
   THE LOADING VEIL
   ========================================================================= */
.veil {
  position: fixed; inset: 0; z-index: 50;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: var(--background);
}
.veil__inner { display: flex; flex-direction: column; align-items: center; }
.veil__helmet {
  position: relative; width: 7.2rem; height: 8.5rem;
  -webkit-mask-size: contain; mask-size: contain;
  -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
  -webkit-mask-position: center; mask-position: center;
}
.veil__shell { position: absolute; inset: 0; background: var(--foreground); opacity: 0.12; }
.veil__fill { position: absolute; inset: 0; background: var(--foreground); transform-origin: top; transform: scaleY(0); }
.veil__name {
  margin-top: 1.75rem; font-size: var(--type-lead); text-transform: uppercase;
  line-height: var(--leading-flat); letter-spacing: 0.18em;
}
.veil__meter { position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: var(--border-muted); }
.veil__meter i { display: block; height: 100%; background: var(--foreground); transform-origin: left; transform: scaleX(0); }

/* ============================================================================
   THE MOBILE SHEET
   ========================================================================= */
.sheet {
  position: fixed; inset: 0; z-index: 50; background: var(--background);
  padding: 1.5rem 2rem; display: flex; flex-direction: column;
}
.sheet__top { display: flex; align-items: center; justify-content: space-between; }
.sheet__close { position: relative; width: 1.5rem; height: 1.5rem; }
.sheet__close span {
  position: absolute; left: 0; top: 50%; width: 1.5rem; height: 1px; background: var(--foreground);
}
.sheet__close span:first-child { transform: rotate(45deg); }
.sheet__close span:last-child { transform: rotate(-45deg); }
.sheet__nav { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 1rem; }
@media (min-width: 640px) { .sheet__nav { gap: 1.5rem; } }
.sheet__nav a {
  font-family: var(--font-display); font-weight: 700; font-size: var(--type-heading);
  text-transform: uppercase; line-height: var(--leading-headline);
  transition: color var(--duration-fast) var(--ease-entrance);
}
@media (min-width: 640px) { .sheet__nav a { font-size: var(--type-display); } }
.sheet__nav a:hover { color: var(--accent); }

/* ============================================================================
   2 — THE SEASON SO FAR
   ========================================================================= */
[data-season] {
  position: relative; isolation: isolate;
  min-height: 100lvh; overflow: hidden;
  background: var(--surface-black); color: var(--foreground-on-dark);
}
/* the seam: a chequered flag coming apart */
.season__seam {
  position: absolute; left: 0; right: 0; top: 0; height: 26vh; z-index: 30;
  pointer-events: none; width: 100%;
}
.season__map { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; }
/* the instrument panel sits behind the copy, so the reading edge is shaded */
.season__scrim {
  position: absolute; inset: 0; z-index: 10; pointer-events: none;
  background: linear-gradient(to right,
    rgb(9 10 11 / 0.94) 0%, rgb(9 10 11 / 0.86) 26%, rgb(9 10 11 / 0.55) 48%, rgb(9 10 11 / 0) 74%);
}
@media (max-width: 1023px) {
  .season__scrim { background: linear-gradient(to bottom, rgb(9 10 11 / 0) 0%, rgb(9 10 11 / 0.7) 34%, rgb(9 10 11 / 0.92) 60%); }
}
.season__content {
  position: relative; z-index: 20; min-height: 100lvh;
  display: flex; flex-direction: column; justify-content: center;
  padding: 1.5rem; gap: 2rem;
}
@media (min-width: 640px) { .season__content { padding: 2rem; } }
@media (min-width: 1280px) { .season__content { padding: 3rem 3rem 3.5rem; } }
.season__eyebrow {
  font-size: var(--type-eyebrow); font-weight: 500; text-transform: uppercase;
  line-height: var(--leading-flat); letter-spacing: var(--raw-tracking-eyebrow);
  color: var(--accent);
}
.season__head {
  font-family: var(--font-display); font-weight: 700; text-transform: uppercase;
  font-size: var(--type-heading); line-height: var(--leading-headline);
  max-width: 9em; margin-top: 1rem;
}
@media (min-width: 768px) { .season__head { font-size: var(--type-display); } }
@media (min-width: 1280px) { .season__head { font-size: var(--type-display-sm); } }
.season__grid { display: flex; flex-direction: column; gap: 2rem; }
@media (min-width: 1024px) {
  .season__grid { flex-direction: row; align-items: flex-end; justify-content: space-between; gap: 4rem; }
}
.season__copy {
  font-size: var(--type-body); text-transform: uppercase; line-height: 1.5;
  color: var(--foreground-on-dark-muted); max-width: 28em;
}
.season__copy p + p { margin-top: 0.75rem; }
.season__rows { display: flex; flex-wrap: wrap; gap: 2rem 3rem; }
.season__row dt {
  font-size: var(--type-eyebrow); text-transform: uppercase;
  letter-spacing: var(--raw-tracking-label); color: var(--foreground-on-dark-faint);
}
.season__row dd {
  font-family: var(--font-display); font-weight: 500; font-size: var(--type-heading);
  line-height: var(--leading-cap); letter-spacing: var(--raw-tracking-stat);
  margin-top: 0.5rem;
}
.season__row dd em { font-style: normal; color: var(--accent); }
.season__legend {
  display: flex; gap: 1.5rem; flex-wrap: wrap;
  font-size: var(--type-eyebrow); text-transform: uppercase;
  letter-spacing: var(--raw-tracking-eyebrow); color: var(--foreground-on-dark-faint);
  border-top: 1px solid var(--border-on-dark); padding-top: 1rem;
}
.season__legend b { font-weight: 500; color: var(--foreground-on-dark); }

/* ============================================================================
   3 — FROM KARTS TO F1 (the timeline)
   ========================================================================= */
[data-timeline] {
  container-type: inline-size;
  position: relative; background: var(--surface-dark); color: var(--foreground-on-dark);
  overflow: hidden;
}
.tl__head { padding: 8.3333cqw 3.3333cqw 5.5556cqw; position: relative; z-index: 5; }
.tl__eyebrow {
  font-size: 0.8333cqw; font-weight: 500; text-transform: uppercase;
  line-height: var(--leading-flat); letter-spacing: var(--raw-tracking-eyebrow); color: var(--accent);
}
.tl__title {
  font-family: var(--font-display); font-weight: 700; text-transform: uppercase;
  font-size: 3.8194cqw; line-height: var(--leading-headline); margin-top: 1.1111cqw;
}
.tl__rows { position: relative; }
/* the rail down the middle */
.tl__rail {
  position: absolute; left: 50%; top: 0; bottom: 0; width: 1px;
  background: var(--timeline-rail); z-index: 4; transform: translateX(-50%);
}
.tl__thread {
  position: absolute; left: 0; top: 0; width: 1px; background: var(--foreground-on-dark);
  transform-origin: top; height: 100%; transform: scaleY(0);
}
.tl__marker {
  position: absolute; left: 50%; top: 0; width: 0.6944cqw; height: 0.6944cqw;
  border: 1px solid var(--foreground-on-dark); background: var(--surface-dark);
  z-index: 6; transform: translate(-50%, -50%) rotate(0deg);
}
.tl__row {
  position: relative; z-index: 5; display: grid; align-items: center;
  grid-template-columns: 1fr 1fr; gap: 0 4.1667cqw;
  padding: 0 3.3333cqw; min-height: 27.7778cqw;
  transition: opacity var(--duration-normal) var(--ease-entrance);
}
.tl__row:nth-child(even) .tl__plate { order: 2; }
.tl__row:nth-child(even) .tl__text { order: 1; text-align: right; }
.tl__row:nth-child(even) .tl__text .tx { justify-content: flex-end; }
[data-timeline].is-hovering .tl__row { opacity: 0.28; }
[data-timeline].is-hovering .tl__row.is-active { opacity: 1; }
.tl__plate {
  position: relative; aspect-ratio: 4 / 3; overflow: hidden;
  background: var(--timeline-fill);
  outline: 1px solid var(--timeline-outline); outline-offset: -1px;
  /* stepped corners */
  clip-path: polygon(
    0 0, calc(100% - 2.2222cqw) 0, 100% 2.2222cqw, 100% 100%,
    2.2222cqw 100%, 0 calc(100% - 2.2222cqw));
  transition: inset var(--duration-plate) var(--ease-plate);
}
.tl__plate img {
  position: absolute; inset: -6%; width: 112%; height: 112%;
  object-fit: cover; will-change: transform;
}
.tl__plate figcaption {
  position: absolute; left: 1.1111cqw; bottom: 1.1111cqw; z-index: 3;
  font-size: 0.8333cqw; text-transform: uppercase; letter-spacing: var(--raw-tracking-eyebrow);
  color: var(--foreground-on-dark); mix-blend-mode: difference;
}
.tl__scrim { position: absolute; inset: 0; z-index: 2; background: linear-gradient(to top, rgb(9 10 11 / 0.55), transparent 55%); }
.tl__year {
  font-family: var(--font-display); font-weight: 700; font-size: 2.5cqw;
  line-height: var(--leading-cap); letter-spacing: var(--raw-tracking-stat);
  color: var(--foreground-on-dark);
}
.tl__label {
  font-family: var(--font-display); font-weight: 500; text-transform: uppercase;
  font-size: 1.6667cqw; line-height: var(--leading-headline); margin-top: 1.1111cqw;
}
.tl__note {
  font-size: 0.9722cqw; text-transform: uppercase; line-height: 1.5;
  color: var(--foreground-on-dark-muted); margin-top: 1.1111cqw; max-width: 24em;
}
.tl__row:nth-child(even) .tl__note { margin-left: auto; }
@media (max-width: 767px) {
  .tl__row { grid-template-columns: 1fr; gap: 1rem; padding: 0 1.5rem 3rem; min-height: 0; }
  .tl__row:nth-child(even) .tl__plate { order: 0; }
  .tl__row:nth-child(even) .tl__text { order: 0; text-align: left; }
  .tl__row:nth-child(even) .tl__text .tx { justify-content: flex-start; }
  .tl__row:nth-child(even) .tl__note { margin-left: 0; }
  .tl__rail { left: 1.5rem; }
  .tl__marker { left: 1.5rem; }
  .tl__head { padding: 4rem 1.5rem 2rem; }
  .tl__title { font-size: var(--type-heading); }
  .tl__eyebrow { font-size: var(--type-eyebrow); }
  .tl__year { font-size: var(--type-year); }
  .tl__label { font-size: var(--type-title); }
  .tl__note { font-size: var(--type-body); }
  .tl__plate figcaption { font-size: var(--type-eyebrow); left: 1rem; bottom: 1rem; }
  .tl__marker { width: 10px; height: 10px; }
}

/* ============================================================================
   4 — FROM THE PADDOCK
   ========================================================================= */
[data-paddock] {
  container-type: inline-size;
  position: relative; isolation: isolate;
  background: var(--background); color: var(--foreground); overflow: hidden;
}
.pd__contours { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; }
.pd__inner { position: relative; z-index: 10; padding: 8.3333cqw 3.3333cqw 0; }
.pd__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4.1667cqw; align-items: start; }
.pd__eyebrow {
  font-size: 0.8333cqw; font-weight: 500; text-transform: uppercase;
  line-height: var(--leading-flat); letter-spacing: var(--raw-tracking-eyebrow); color: var(--accent);
}
.pd__title {
  font-family: var(--font-display); font-weight: 700; text-transform: uppercase;
  font-size: 6.6667cqw; line-height: var(--leading-headline); margin-top: 1.1111cqw;
  max-width: 6em;
}
.pd__body {
  font-size: 0.9722cqw; text-transform: uppercase; line-height: 1.55;
  max-width: 30em; margin-top: 2.7778cqw;
}
.pd__body p + p { margin-top: 1.1111cqw; }
.pd__meta {
  display: flex; gap: 2.7778cqw; margin-top: 2.7778cqw;
  border-top: 1px solid var(--border-muted); padding-top: 1.3889cqw;
}
.pd__meta dt {
  font-size: 0.8333cqw; text-transform: uppercase;
  letter-spacing: var(--raw-tracking-label); color: var(--foreground-muted);
}
.pd__meta dd {
  font-family: var(--font-display); font-weight: 500; font-size: 1.6667cqw;
  line-height: var(--leading-cap); letter-spacing: var(--raw-tracking-stat); margin-top: 0.5556cqw;
}
/* chamfered dark button */
.pd__btn {
  position: relative; display: inline-flex; align-items: center; gap: 1.6em;
  font-size: 1.1111cqw; text-transform: uppercase; line-height: var(--leading-flat);
  height: 3.2em; padding: 0 1.8em; margin-top: 2.7778cqw;
  color: var(--foreground-on-dark);
  clip-path: polygon(0 0, 100% 0, 100% calc(100% - 0.9em), calc(100% - 0.9em) 100%, 0 100%);
  background: var(--surface-black); isolation: isolate; overflow: hidden;
  transition: color var(--duration-normal) var(--ease-plate);
}
.pd__btn::before {
  content: ""; position: absolute; inset: 0; z-index: -1; background: var(--accent);
  transform-origin: left; transform: scaleX(0);
  transition: transform var(--duration-normal) var(--ease-plate);
}
.pd__btn:hover { color: var(--surface-black); }
.pd__btn:hover::before { transform: scaleX(1); }
.pd__btn svg { width: 0.95em; height: 0.73em; overflow: visible; }
.pd__btn path { stroke: currentColor; }
/* the portrait bleeding off both ends */
.pd__figure {
  position: relative; margin: 4.1667cqw -3.3333cqw 0;
  height: 41.6667cqw; overflow: hidden;
}
.pd__figure img { width: 100%; height: 100%; object-fit: cover; object-position: center 22%; }
.pd__melt {
  position: absolute; left: 0; right: 0; bottom: 0; height: 55%;
  background: linear-gradient(to bottom, transparent, var(--surface-black) 78%, var(--surface-black));
}
/* the calendar band */
.pd__band { position: relative; background: var(--surface-black); color: var(--foreground-on-dark); padding: 3.3333cqw 3.3333cqw 4.1667cqw; }
.pd__band-head {
  display: flex; align-items: baseline; justify-content: space-between;
  font-size: 0.8333cqw; text-transform: uppercase; letter-spacing: var(--raw-tracking-eyebrow);
  color: var(--foreground-on-dark-faint); border-bottom: 1px solid var(--border-on-dark);
  padding-bottom: 1.1111cqw;
}
.pd__band-head b { color: var(--accent); font-weight: 500; }
.cal {
  position: relative; display: grid; grid-template-columns: repeat(5, 1fr);
  margin-top: 2.7778cqw;
  -webkit-mask-image: linear-gradient(to right, transparent 0, #000 var(--raw-edge-fade-share), #000 calc(100% - var(--raw-edge-fade-share)), transparent 100%);
  mask-image: linear-gradient(to right, transparent 0, #000 var(--raw-edge-fade-share), #000 calc(100% - var(--raw-edge-fade-share)), transparent 100%);
}
.cal__round { position: relative; padding: 1.3889cqw 0.5556cqw; }
.cal__connector { position: absolute; left: 0; top: 0; width: 100%; height: 1px; overflow: visible; }
.cal__no {
  font-size: 0.8333cqw; letter-spacing: var(--raw-tracking-label);
  color: var(--foreground-on-dark-faint); text-transform: uppercase;
}
.cal__name {
  font-family: var(--font-display); font-weight: 500; text-transform: uppercase;
  font-size: 1.3889cqw; line-height: var(--leading-headline); margin-top: 0.5556cqw;
}
.cal__date {
  font-size: 0.8333cqw; text-transform: uppercase; margin-top: 0.5556cqw;
  color: var(--foreground-on-dark-muted);
}
.cal__result {
  font-family: var(--font-display); font-weight: 700; font-size: 1.1111cqw;
  line-height: var(--leading-cap); letter-spacing: var(--raw-tracking-stat);
  margin-top: 1.1111cqw; color: var(--foreground-on-dark);
}
.cal__round.is-live .cal__result, .cal__round.is-live .cal__name { color: var(--accent); }
.cal__bracket { position: absolute; inset: 0.5556cqw -0.2778cqw; pointer-events: none; }
.cal__pulse {
  position: absolute; left: 50%; top: 0.5556cqw; width: 0.4167cqw; height: 0.4167cqw;
  transform: translate(-50%, -50%); border-radius: 50%; background: var(--accent);
}
@media (max-width: 1023px) {
  .pd__grid { grid-template-columns: 1fr; gap: 2rem; }
  .pd__inner { padding: 4rem 1.5rem 0; }
  .pd__eyebrow { font-size: var(--type-eyebrow); }
  .pd__title { font-size: var(--type-display); }
  .pd__body, .pd__note { font-size: var(--type-body); }
  .pd__meta dt { font-size: var(--type-eyebrow); }
  .pd__meta dd { font-size: var(--type-title); }
  .pd__btn { font-size: var(--type-body); }
  .pd__figure { margin: 2rem -1.5rem 0; height: 60vw; }
  .pd__band { padding: 2rem 1.5rem 3rem; }
  .pd__band-head { font-size: var(--type-eyebrow); }
  .cal { grid-template-columns: repeat(5, minmax(9rem, 1fr)); overflow-x: auto; }
  .cal__no, .cal__date { font-size: var(--type-eyebrow); }
  .cal__name { font-size: var(--type-label); }
  .cal__result { font-size: var(--type-label); }
  .cal__pulse { width: 6px; height: 6px; }
}

/* ============================================================================
   5 — KEEP PUSHING FORWARD (the footer)
   ========================================================================= */
[data-footer] {
  container-type: inline-size;
  position: relative; background: var(--accent); padding: 16px;
}
.ft__panel {
  position: relative; isolation: isolate; overflow: hidden;
  background: var(--surface-black); color: var(--foreground-on-dark);
  min-height: 44.4444cqw; display: flex; flex-direction: column;
}
.ft__contours { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; opacity: 0.1; }
.ft__inner {
  position: relative; z-index: 10; flex: 1;
  display: grid; grid-template-columns: 1.4fr 1fr; gap: 4.1667cqw;
  padding: 5.5556cqw 3.3333cqw 0;
}
.ft__title {
  font-family: var(--font-display); font-weight: 700; text-transform: uppercase;
  font-size: 5.5556cqw; line-height: var(--leading-headline); max-width: 7em;
}
.ft__eyebrow {
  font-size: 0.8333cqw; font-weight: 500; text-transform: uppercase;
  line-height: var(--leading-flat); letter-spacing: var(--raw-tracking-eyebrow);
  color: var(--accent); margin-bottom: 1.1111cqw;
}
.ft__nav { display: flex; flex-direction: column; gap: 0.8333cqw; }
.ft__nav a {
  font-size: 1.1111cqw; text-transform: uppercase; line-height: var(--leading-flat);
  color: var(--foreground-on-dark); transition: color var(--duration-fast) var(--ease-entrance);
}
.ft__nav a:hover { color: var(--accent); }
.ft__figure {
  position: absolute; right: 3.3333cqw; bottom: 0; z-index: 5;
  width: 26.3889cqw; pointer-events: none;
}
.ft__figure img { width: 100%; height: auto; }
.ft__legal {
  position: relative; z-index: 10;
  display: flex; flex-wrap: wrap; gap: 1.3889cqw; justify-content: space-between;
  border-top: 1px solid var(--border-on-dark);
  margin: 4.1667cqw 3.3333cqw 0; padding: 1.3889cqw 0 2.2222cqw;
  font-size: 0.8333cqw; text-transform: uppercase; letter-spacing: var(--raw-tracking-eyebrow);
  color: var(--foreground-on-dark-faint);
}
.ft__legal a { transition: color var(--duration-fast) var(--ease-entrance); }
.ft__legal a:hover { color: var(--accent); }
@media (max-width: 1023px) {
  .ft__inner { grid-template-columns: 1fr; padding: 3rem 1.5rem 0; gap: 2rem; }
  .ft__title { font-size: var(--type-display); }
  .ft__eyebrow { font-size: var(--type-eyebrow); }
  .ft__nav a { font-size: var(--type-label); }
  .ft__figure { position: relative; right: auto; width: 60%; margin: 2rem auto -1px; }
  .ft__legal { font-size: var(--type-eyebrow); margin: 2rem 1.5rem 0; padding: 1rem 0 1.5rem; }
  .ft__panel { min-height: 0; }
}

@media (prefers-reduced-motion: reduce) {
  * { scroll-behavior: auto !important; }
}
</style>
</head>
<body>

<!-- ==========================================================================
     THE STICKY STACK — hero (z0) + season (z10) pin and are covered;
     the timeline (relative, z20) covers but is never covered.
     ======================================================================= -->
<div data-stack>

  <!-- ---------------------------------------------------------------- HERO -->
  <div data-pin data-pin-hero style="z-index:0">
    <div data-pin-inner>
      <section data-hero id="hero">
        <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>

        <!-- the box the layout owns; the scene fits the subject to it below xl -->
        <div class="hero__figure" aria-hidden="true"><div class="hero__fit" data-hero-fitbox></div></div>

        <div class="hero__ramp" aria-hidden="true"></div>
        <div class="hero__ramp2" aria-hidden="true"></div>

        <div class="hero__content">

          <header class="masthead" data-reveal="masthead">
            <a class="masthead__logo" href="/" aria-label="Grido1 Racing Systems">
              <img src="assets/grido1-logo.webp" width="424" height="97" alt="" data-ph="logo">
            </a>
            <nav class="masthead__nav" aria-label="Primary">
              <ul>
                <li><a href="/driver">Driver</a></li>
                <li><a href="/season">SEASON</a></li>
                <li><a href="/journal">journal</a></li>
                <li><a href="/next-race">next race</a></li>
                <li><a href="/store">store</a></li>
              </ul>
            </nav>
            <a class="masthead__garage" href="/garage"><span aria-hidden="true">[ </span>Garage<span aria-hidden="true"> &rarr; ]</span></a>
            <button class="burger" type="button" data-burger aria-label="Open menu" aria-expanded="false">
              <span></span><span></span>
            </button>
          </header>

          <div class="hero__middle">

            <div class="hero__identity">
              <div>
                <p class="hero__id" data-reveal="id">driver_012</p>
                <h1 class="hero__name" data-text="words" data-stagger="110" data-config="REVEAL" data-mode="once" data-delay="180">kimi antonelli</h1>
              </div>
              <ul class="hero__meta">
                <li data-reveal="meta"><img class="ico-flag" src="assets/flag-italy.webp" width="18" height="12" alt="Italy" data-ph="flag"><span>Italy</span></li>
                <li data-reveal="meta"><img class="ico-rookie" src="assets/icon-rookie.svg" width="16" height="16" alt="" data-ph="rookie"><span>rookie season_2026</span></li>
                <li data-reveal="meta"><img class="ico-merc" src="assets/mercedes-logo.webp" width="14" height="14" alt="" data-ph="merc"><span>Mercedes-AMG F1 Team</span></li>
              </ul>
            </div>

            <div data-hero-panels data-reveal="panels">
              <section class="panel" data-brackets aria-label="Next race">
                <p class="panel__eyebrow">next race</p>
                <div class="panel__race">
                  <dl class="panel__list">
                    <dt>belgian gp</dt>
                    <dd>spa-francorchamps</dd>
                    <dd><time datetime="2026-07-27">27 jul 2026</time></dd>
                  </dl>
                  <img data-hero-map src="assets/circuit-spa.webp" width="312" height="199" alt="Spa-Francorchamps circuit layout" data-ph="circuit">
                </div>
              </section>

              <section class="panel" data-brackets aria-label="Season stats">
                <p class="panel__eyebrow">Season stats</p>
                <dl data-hero-stats>
                  <div class="stat"><dt>Races</dt><dd data-text="letters" data-stagger="26" data-config="FIGURE" data-mode="forward" data-delay="0">12</dd></div>
                  <div class="stat"><dt>Podiums</dt><dd data-text="letters" data-stagger="26" data-config="FIGURE" data-mode="forward" data-delay="90">3</dd></div>
                  <div class="stat"><dt>Points</dt><dd data-text="letters" data-stagger="26" data-config="FIGURE" data-mode="forward" data-delay="180">118</dd></div>
                </dl>
              </section>
            </div>

          </div>

          <div class="hero__actions" data-reveal="actions">
            <a class="trailer" href="/trailer">
              <img src="assets/play-button.svg" width="32" height="32" alt="" data-ph="play">
              <span class="trailer__lines"><b>watch trailer</b><time datetime="PT1M26S">01:26</time></span>
            </a>

            <a class="cta" href="/driver/kimi-antonelli">
              <svg class="cta__frame" viewBox="0 0 220 50" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path d="M220 42L212.932 50H0V0H220V42Z" fill="#0E0F14"/>
                <path class="cta__flood" d="M220 42L212.932 50H0V0H220V42Z" fill="var(--accent)"/>
